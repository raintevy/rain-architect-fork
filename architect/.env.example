# Copy to `.env` (git-ignored) and fill in your credentials.

# --- Claude (required) ---
ANTHROPIC_API_KEY=
# Base URL for an Anthropic-compatible endpoint (e.g. an Azure AI Foundry
# deployment). Leave blank to use the default Anthropic API.
ANTHROPIC_BASE_URL=

# --- Embeddings (optional; enables slate relevance + hybrid retrieval) ---
# Use EITHER Azure OpenAI (set the two AZURE_* vars) OR plain OpenAI (OPENAI_API_KEY).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_KEY=
