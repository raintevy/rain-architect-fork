# Copy this file to `.env` (same directory) and fill in your values.
# `.env` is git-ignored and is read at runtime by the VQA / grasp-verification
# services (get_vqa_service.py, get_grasp_vqa_service.py).
#
# Only the variables for your chosen VQA backend are required:
#   - vqa_server_name == "azure_openai"  -> the AZURE_OPENAI_* vars
#   - vqa_server_name == "openai"        -> OPENAI_API_KEY
#   - vqa_server_name == "qwen"          -> none (uses a local/served model)

# --- OpenAI ---
OPENAI_API_KEY=

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=

# --- Camera serials (read by the streaming nodes at startup) ---
# RealSense
SCENE_CAMERA_SERIAL=
WRIST_CAMERA_SERIAL=
# ZED (integers)
ZED_SCENE_SERIAL=
ZED_WRIST_SERIAL=
